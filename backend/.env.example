# Usado apenas ao rodar a API fora do Docker (no compose, as variáveis vêm do .env da raiz).
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/lms_legal"
CORS_ORIGINS="http://localhost:4200,http://localhost:8080"
SIMULATOR_SPEED=5
# Modo do robô e token das rotas /api/rpa/ (veja o .env.example da raiz)
RPA_MODE=simulated
RPA_API_TOKEN=""
