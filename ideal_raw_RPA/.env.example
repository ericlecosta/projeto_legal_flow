USER_ID="seu_usuario_lge"
PASSWORD="sua_senha_ldap"
EMPLOYEE_NUMBER="YSPxxxxxx"
PERSONAL_IDENTIFICATION_CODE="YYYYMMDD"
LOGIN_ADDRESS="https://sso.lge.com/"
LMS_INDEX="https://lms.lge.com/#/app/dashboard"
LMS_CONTRACT_REVIEW_MANAGEMENT="https://lms.lge.com/#/app/contract/search"

# Configurações do Navegador / Playwright (true recomendado para Docker / CI)
HEADLESS=true

# Filtros da extração (main.py)
LMS_SUBSIDIARY_CODE="LGESP"
LMS_PERIODO="3"
LMS_FILTRO_DEPARTAMENTO="mao"

# API do monitor: sem API_URL o robô roda sem registrar a execução nem gravar os contratos no banco.
# Fora do Docker: http://localhost:8000/api  ·  Dentro do compose: http://api:8000/api (já definido lá)
API_URL="http://localhost:8000/api"
# Mesmo valor de RPA_API_TOKEN configurado na API
RPA_API_TOKEN=""
# manual (padrão) ou scheduled, para aparecer como "Agendado" no monitor
RPA_TRIGGER="manual"
