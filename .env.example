# ==========================================
# Configurações de Ambiente - LMS Legal
# ==========================================

# Credenciais corporativas LGE para autenticação SSO e LMS
USER_ID="seu_usuario_lge"
PASSWORD="sua_senha_ldap"
EMPLOYEE_NUMBER="YSPxxxxxx"
PERSONAL_IDENTIFICATION_CODE="YYYYMMDD"

# URLs do Sistema LGE
LOGIN_ADDRESS="https://sso.lge.com/"
LMS_INDEX="https://lms.lge.com/#/app/dashboard"
LMS_CONTRACT_REVIEW_MANAGEMENT="https://lms.lge.com/#/app/contract/search"

# Configurações do Navegador / Playwright (true recomendado para Docker)
HEADLESS=true

# ==========================================
# API Backend (FastAPI) / Banco de Dados / Front-end
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lms_legal
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=8080
# Origens liberadas no CORS (ng serve e front no Docker)
CORS_ORIGINS="http://localhost:4200,http://localhost:8080"

# ==========================================
# Integração robô -> API
# ==========================================
# real = só o robô grava execuções e contratos (sem seed, sem agenda fictícia, sem disparo pelo painel)
# simulated = dados fictícios e simulador ao vivo, para demonstração
RPA_MODE=simulated
# Token compartilhado entre a API e o robô (cabeçalho X-RPA-Token). Gere um valor longo, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vazio desativa as rotas /api/rpa/ e o robô roda sem registrar nada no monitor.
RPA_API_TOKEN=""

# ==========================================
# Simulador do RPA (dados fictícios no dashboard, só no modo simulated)
# ==========================================
# Popula ~30 dias de histórico na primeira subida (só se o banco estiver vazio)
SEED_ON_STARTUP=true
SEED_DAYS=30
# Probabilidade de uma execução simulada falhar (0 a 1)
SIMULATOR_FAILURE_RATE=0.12
# Velocidade das execuções ao vivo (1.0 = tempo real, ~1-2 min; 5 = cinco vezes mais rápido)
SIMULATOR_SPEED=1.0
# Dispara execuções "agendadas" nesses horários enquanto a API estiver no ar
SIMULATOR_SCHEDULER_ENABLED=true
SIMULATOR_SCHEDULE="08:00,12:00,18:00"
